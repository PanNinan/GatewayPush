# =====================================================================
# GatewayWorker 实时数据推送服务 - 环境配置模板
#
# 使用方式：
#   1. 推荐：php start.php env:init     自动生成 .env（含随机密钥）
#   2. 或手工执行：cp .env.example .env 后逐项填写
#
# 加载优先级（低 -> 高）：
#   代码内默认值
#     < .env
#     < .env.{APP_ENV}
#     < .env.local
#     < .env.{APP_ENV}.local
#     < 真实系统环境变量（容器 / CI 注入，最高优先，不被本文件覆盖）
#
# 安全提示：.env 含真实密钥，已在 .gitignore 中排除，切勿提交到版本库。
# =====================================================================


# ---------------------------------------------------------------------
# 应用基础
# ---------------------------------------------------------------------
APP_NAME=gateway-push
# 运行环境标识：dev | test | prod
# 该值决定加载哪个环境专属文件（如 APP_ENV=prod 时额外加载 .env.prod）
APP_ENV=dev
# 开启后输出 debug 级日志，生产环境请置为 false
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai


# ---------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug
# 是否同时输出到控制台（dev 便于排查，prod 建议 false）
LOG_STDOUT=true
# 日志文件保留天数，超期自动清理
LOG_KEEP_DAYS=30


# ---------------------------------------------------------------------
# Redis（会话 / 设备映射 / 缓存 / 指标存储，唯一外部依赖）
# ---------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 连接超时（秒）
REDIS_TIMEOUT=2.0
# 每进程异步连接数
REDIS_POOL_SIZE=8
# 键名前缀，多套环境共用同一 Redis 实例时必须区分
REDIS_PREFIX=gwpush:


# ---------------------------------------------------------------------
# 内部通信密钥（Register / Gateway / BusinessWorker 三方必须一致）
#
# 留空则自动回退复用 AUTH_SECRET。
# 生产环境建议独立配置：内部通信密钥泄露与业务鉴权密钥泄露影响面不同。
# ---------------------------------------------------------------------
INTERNAL_SECRET=


# ---------------------------------------------------------------------
# 连接鉴权
# ---------------------------------------------------------------------
AUTH_ENABLE=true
# hmac  : 自包含签名 Token（base64(payload).hmac），本地校验无 IO
# store : Redis 反查模式，Token 内容存 Redis
AUTH_MODE=hmac
# 业务鉴权密钥，生产环境必须使用高强度随机值
# 生成方式：php -r "echo bin2hex(random_bytes(32));"
AUTH_SECRET=
# 是否校验报文签名（UDP 无连接，强烈建议开启）
AUTH_SIGN_ENABLE=true
# Token 默认有效期（秒）
AUTH_TOKEN_TTL=7200
# 允许的时钟偏移（秒），同时用于报文时间戳校验
AUTH_CLOCK_SKEW=300
# 校验 uid <-> device_id 绑定关系
AUTH_BIND_DEVICE=true
# 鉴权失败立即断开连接
AUTH_FAIL_CLOSE=true
# 连接建立后 N 秒内未完成鉴权则断开
AUTH_TIMEOUT=15


# ---------------------------------------------------------------------
# 会话管理（断线重连 / 会话保持）
# ---------------------------------------------------------------------
# 会话 Redis 过期时间（秒）
SESSION_TTL=7200
# 心跳超时阈值（秒），需与 HB_SESSION_TIMEOUT 保持一致
SESSION_HEARTBEAT_TTL=90
# 断线重连自动恢复历史会话
SESSION_RESTORE=true


# ---------------------------------------------------------------------
# Register 注册中心（Gateway 与 BusinessWorker 的地址发现服务）
# ---------------------------------------------------------------------
REGISTER_ENABLE=true
# Register 监听地址。单机部署保持 127.0.0.1；集群部署改为 0.0.0.0:1238 或内网 IP
REGISTER_LISTEN=127.0.0.1:1238
# BusinessWorker 连接的注册中心地址。留空则复用 REGISTER_LISTEN（单机推荐）
REGISTER_ADDRESS=


# ---------------------------------------------------------------------
# WebSocket 网关（长连接实时推送）
# ---------------------------------------------------------------------
WS_ENABLE=true
WS_LISTEN=websocket://0.0.0.0:8282
# 进程数（Windows 无 pcntl，自动降级为 1）
WS_COUNT=4
# 集群部署时改为本机内网 IP
WS_LAN_IP=127.0.0.1
# 内部通信端口起始值，多机部署需错开
WS_START_PORT=2300


# ---------------------------------------------------------------------
# SSL（生产环境 WSS 必需）
# ---------------------------------------------------------------------
SSL_ENABLE=false
SSL_CERT=
SSL_PK=


# ---------------------------------------------------------------------
# UDP 网关（轻量化数据上报）
#
# UDP 无连接，采用应用层会话识别（报文内 device_id + token）。
# 网关仅做协议解析与签名校验，业务处理经 Redis 队列解耦投递。
# ---------------------------------------------------------------------
UDP_ENABLE=true
UDP_LISTEN=udp://0.0.0.0:8283
# 进程数（Windows 自动降级为 1）
UDP_COUNT=2
# 单包最大字节数，超出直接丢弃
UDP_MAX_PACKET_SIZE=8192
# UDP -> 业务进程 的解耦队列
UDP_QUEUE_ENABLE=true
UDP_QUEUE_KEY=queue:udp:in
# 队列长度上限，溢出丢弃并告警
UDP_QUEUE_MAX_LEN=10000
# 业务侧单次批量消费条数
UDP_QUEUE_BATCH=100
# 业务侧消费周期（秒）
UDP_QUEUE_INTERVAL=0.05


# ---------------------------------------------------------------------
# 心跳与死连接清理
#
# HB_PING_* 由 Gateway 原生实现，无需业务层参与
# HB_SESSION_TIMEOUT / HB_CHECK_INTERVAL 为业务层兜底扫描
# ---------------------------------------------------------------------
# 主动心跳间隔（秒）
HB_PING_INTERVAL=25
# 连续 N 次无上行数据则断开
HB_PING_NOT_RESPONSE_LIMIT=2
# 业务层会话心跳超时阈值（秒）
HB_SESSION_TIMEOUT=90
# 死连接巡检周期（秒）
HB_CHECK_INTERVAL=10


# ---------------------------------------------------------------------
# BusinessWorker 业务进程
# ---------------------------------------------------------------------
# 进程数（Windows 自动降级为 1）
BUSINESS_WORKER_COUNT=4


# ---------------------------------------------------------------------
# 监控指标
# ---------------------------------------------------------------------
MONITOR_ENABLE=true
# 上报周期（秒）
MONITOR_INTERVAL=60
# 指标数据保留时长（秒）
MONITOR_TTL=600
