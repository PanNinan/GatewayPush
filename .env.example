# =====================================================================
# GatewayWorker 实时数据推送服务 - 环境配置模板
#
# 使用方式：
#   1. 推荐：php start.php env:init     自动生成 .env（含随机密钥）
#   2. 或手工执行：cp .env.example .env 后逐项填写
#
# 加载优先级（低 -> 高）：
#   代码内默认值
#     < .env
#     < .env.{APP_ENV}
#     < .env.local
#     < .env.{APP_ENV}.local
#     < 真实系统环境变量（容器 / CI 注入，最高优先，不被本文件覆盖）
#
# 安全提示：.env 含真实密钥，已在 .gitignore 中排除，切勿提交到版本库。
# =====================================================================


# ---------------------------------------------------------------------
# 应用基础
# ---------------------------------------------------------------------
APP_NAME=gateway-push
# 运行环境标识：dev | test | prod
# 该值决定加载哪个环境专属文件（如 APP_ENV=prod 时额外加载 .env.prod）
APP_ENV=dev
# 开启后输出 debug 级日志，生产环境请置为 false
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai


# ---------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug
# 是否同时输出到控制台（dev 便于排查，prod 建议 false）
LOG_STDOUT=true
# 日志文件保留天数，超期自动清理
LOG_KEEP_DAYS=30
# workerman.log 单文件上限（MB），超出后原地截断保留后半；0 = 不轮转
LOG_MAX_MB=10

# --- 日志归档（默认关闭）---------------------------------------------
# 开启后：明文日志超过 LOG_ARCHIVE_AFTER_DAYS 天即压进
#   {LOG_ARCHIVE_DIR}/{YYYY-MM}.tar.gz
# 并删除明文，归档包超过 LOG_ARCHIVE_KEEP_DAYS 天后删除。
# 生命周期：明文(7天) -> 归档包(180天) -> 删除
# 注意：必须满足 0 < LOG_ARCHIVE_AFTER_DAYS < LOG_KEEP_DAYS，否则明文会先被
#       清理任务删掉、归档永远拿不到内容（违反时只告警并跳过，不影响启动）。
# 包为 POSIX ustar 格式，Linux 下 tar -xzf 直接可解，也可按需单取：
#   tar -xzf runtime/logs/archive/2026-09.tar.gz api_2026-09-01.log
LOG_ARCHIVE_ENABLE=false
# 明文转为归档的天数（须小于 LOG_KEEP_DAYS）
LOG_ARCHIVE_AFTER_DAYS=7
# 归档目录；留空 = runtime/logs/archive
LOG_ARCHIVE_DIR=
# 归档包保留天数
LOG_ARCHIVE_KEEP_DAYS=180
# gzip 压缩级别 1~9（越大越省空间、越耗 CPU；越界自动回落 6）
LOG_ARCHIVE_LEVEL=6


# ---------------------------------------------------------------------
# Redis（会话 / 设备映射 / 缓存 / 指标存储，唯一外部依赖）
# ---------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 连接超时（秒）
REDIS_TIMEOUT=2.0
# 每进程异步连接数
REDIS_POOL_SIZE=8
# 键名前缀，多套环境共用同一 Redis 实例时必须区分
REDIS_PREFIX=gwpush:


# ---------------------------------------------------------------------
# 内部通信密钥（Register / Gateway / BusinessWorker 三方必须一致）
#
# 留空则自动回退复用 AUTH_SECRET。
# 生产环境建议独立配置：内部通信密钥泄露与业务鉴权密钥泄露影响面不同。
# ---------------------------------------------------------------------
INTERNAL_SECRET=


# ---------------------------------------------------------------------
# 连接鉴权
# ---------------------------------------------------------------------
AUTH_ENABLE=true
# hmac  : 自包含签名 Token（base64(payload).hmac），本地校验无 IO
# store : Redis 反查模式，Token 内容存 Redis
AUTH_MODE=hmac
# 业务鉴权密钥，生产环境必须使用高强度随机值
# 生成方式：php -r "echo bin2hex(random_bytes(32));"
AUTH_SECRET=
# 是否校验报文签名（UDP 无连接，强烈建议开启）
AUTH_SIGN_ENABLE=true
# Token 默认有效期（秒）
AUTH_TOKEN_TTL=7200
# 允许的时钟偏移（秒），同时用于报文时间戳校验
AUTH_CLOCK_SKEW=300
# 校验 uid <-> device_id 绑定关系
AUTH_BIND_DEVICE=true
# 鉴权失败立即断开连接
AUTH_FAIL_CLOSE=true
# 连接建立后 N 秒内未完成鉴权则断开
AUTH_TIMEOUT=15


# ---------------------------------------------------------------------
# 会话管理（断线重连 / 会话保持）
# ---------------------------------------------------------------------
# 会话 Redis 过期时间（秒）
SESSION_TTL=7200
# 心跳超时阈值（秒），需与 HB_SESSION_TIMEOUT 保持一致
SESSION_HEARTBEAT_TTL=90
# 断线重连自动恢复历史会话
SESSION_RESTORE=true


# ---------------------------------------------------------------------
# Register 注册中心（Gateway 与 BusinessWorker 的地址发现服务）
# ---------------------------------------------------------------------
REGISTER_ENABLE=true
# Register 监听地址。单机部署保持 127.0.0.1；集群部署改为 0.0.0.0:1238 或内网 IP
REGISTER_LISTEN=127.0.0.1:1238
# BusinessWorker 连接的注册中心地址。留空则复用 REGISTER_LISTEN（单机推荐）
REGISTER_ADDRESS=


# ---------------------------------------------------------------------
# WebSocket 网关（长连接实时推送）
# ---------------------------------------------------------------------
WS_ENABLE=true
WS_LISTEN=websocket://0.0.0.0:8282
# 进程数（Windows 无 pcntl，自动降级为 1）
WS_COUNT=4
# 集群部署时改为本机内网 IP
WS_LAN_IP=127.0.0.1
# 内部通信端口起始值，多机部署需错开
WS_START_PORT=2300


# ---------------------------------------------------------------------
# SSL（生产环境 WSS 必需）
# ---------------------------------------------------------------------
SSL_ENABLE=false
SSL_CERT=
SSL_PK=


# ---------------------------------------------------------------------
# UDP 网关（轻量化数据上报）
#
# UDP 无连接，采用应用层会话识别（报文内 device_id + token）。
# 网关仅做协议解析与签名校验，业务处理经 Redis 队列解耦投递。
# ---------------------------------------------------------------------
UDP_ENABLE=true
UDP_LISTEN=udp://0.0.0.0:8283
# 进程数（Windows 自动降级为 1）
UDP_COUNT=2
# 单包最大字节数，超出直接丢弃
UDP_MAX_PACKET_SIZE=8192
# UDP -> 业务进程 的解耦队列
UDP_QUEUE_ENABLE=true
UDP_QUEUE_KEY=queue:udp:in
# 队列长度上限，溢出丢弃并告警
UDP_QUEUE_MAX_LEN=10000
# 业务侧单次批量消费条数
UDP_QUEUE_BATCH=100
# 业务侧消费周期（秒）
UDP_QUEUE_INTERVAL=0.05

# 业务进程 -> UDP 网关 的出站队列（服务端定向推送）
# UDP 的 client_id 不在 Gateway 连接表内，出站需由网关进程直接 sendto
UDP_OUT_QUEUE_ENABLE=true
UDP_OUT_QUEUE_KEY=queue:udp:out
# 单次原子弹出条数（Lua 取批，多进程并发安全）
UDP_OUT_QUEUE_BATCH=200
# 出站消费周期（秒）
UDP_OUT_QUEUE_INTERVAL=0.05


# ---------------------------------------------------------------------
# 心跳与死连接清理
#
# HB_PING_* 由 Gateway 原生实现，无需业务层参与
# HB_SESSION_TIMEOUT / HB_CHECK_INTERVAL 为业务层兜底扫描
# ---------------------------------------------------------------------
# 主动心跳间隔（秒）
HB_PING_INTERVAL=25
# 连续 N 次无上行数据则断开
HB_PING_NOT_RESPONSE_LIMIT=2
# 业务层会话心跳超时阈值（秒）
HB_SESSION_TIMEOUT=90
# 死连接巡检周期（秒）
HB_CHECK_INTERVAL=10


# ---------------------------------------------------------------------
# BusinessWorker 业务进程
# ---------------------------------------------------------------------
# 进程数（Windows 自动降级为 1）
BUSINESS_WORKER_COUNT=4


# ---------------------------------------------------------------------
# 单对一定向推送
#
# 推送触发入口有两处，最终都汇入同一队列由业务进程消费：
#   1. HTTP 接口  POST /push（见下方 API_* 配置）
#   2. Redis 队列 PUSH_QUEUE_KEY，外部系统 LPUSH/RPUSH 即可
# ---------------------------------------------------------------------
PUSH_ENABLE=true
# 目标不在线时的策略：
#   drop  = 直接丢弃，仅计指标（实时语义，简单）
#   queue = 写入 push:offline:{uid}，设备重连后自动补投（默认）
PUSH_OFFLINE_MODE=queue
# 离线消息保留时长（秒）
PUSH_OFFLINE_TTL=86400
# 单用户离线消息条数上限，超出丢弃最旧的一条并告警
PUSH_OFFLINE_MAX=100
# 重连补投单批条数
PUSH_REPLAY_BATCH=50
# 按消息 msg_id 去重（防止重复投递，依赖调用方传入 msg_id）
PUSH_IDEMPOTENT=true
# 去重窗口（秒）
PUSH_IDEMPOTENT_TTL=600
# 单条业务数据体上限（字节），超出拒绝
PUSH_PAYLOAD_MAX=4096

# 推送出站队列（业务进程消费）
PUSH_QUEUE_ENABLE=true
PUSH_QUEUE_KEY=queue:push:out
# 单次原子弹出条数
PUSH_QUEUE_BATCH=200
# 消费周期（秒）
PUSH_QUEUE_INTERVAL=0.05
# 积压告警阈值
PUSH_QUEUE_MAX_LEN=10000


# ---------------------------------------------------------------------
# HTTP 接口（独立进程，受理推送入队 + 业务动作调用）
#
# 接口清单：POST /push（推送）、POST /action（调用业务动作）、
#           GET /action/{id}（补查动作结果）、GET /stats、GET /health
#
# 鉴权算法：sign = hex(hmac_sha256("{X-Timestamp}|{原始请求体}", API_SECRET))
# 请求头：X-Timestamp（Unix 秒）、X-Sign
# 推送请求体：{"target_type":"uid|device|client","target":"...","payload":{...},
#          "msg_id":"可选","offline_mode":"可选 drop|queue"}
# 动作请求体：{"action":"echo","uid":"user-1","device_id":"可选","params":{...}}
# ---------------------------------------------------------------------
API_ENABLE=true
# 接口验签开关，默认 true。仅供本地调试：设为 false 后请求无需 X-Timestamp / X-Sign。
# 关闭只在监听回环地址时生效；监听 0.0.0.0 / 具体网卡时该开关会被忽略并强制验签。
# 与 AUTH_ENABLE / AUTH_SIGN_ENABLE 无关 —— 那两个是 WS/UDP **报文层**的开关，
# 对本接口无任何影响（唯一关联是 API_SECRET 留空时复用 AUTH_SECRET）。
API_SIGN_ENABLE=false
# 生产环境应仅监听内网地址，或置于网关/反向代理之后
API_LISTEN=http://127.0.0.1:8290
# 接口调用密钥，留空则回退复用 AUTH_SECRET
#
# ⚠ 本密钥同时是**管理面凭证**：持有它即可调用运维动作 kick / revoke / unbind
#   （踢线 / 撤销 Token / 解绑设备），详见「对外接口文档」§9.4「管理面凭证」。
#   ⇒ 不得下发给业务调用方；业务方需要的是 Auth 签发的用户 Token，不是本密钥。
#   ⇒ 变更 API_LISTEN 为非回环地址前必须复查 §9.4（那会把本等式变成真实提权面）。
API_SECRET=
# 请求时间戳有效窗口（秒），超出即拒绝，用于防重放
API_SIGN_TTL=300
# 单 IP 每分钟请求上限，0 = 不限
API_RATE_LIMIT=600
# 请求体上限（字节）
API_BODY_MAX=65536
# POST /action 的同步等待窗口（毫秒）。动作由业务进程经队列执行，本进程只轮询结果，
# 故本值必须大于动作自身的回执超时（ACTION_TIMEOUT），否则会在动作还能给出结果时
# 先行返回 202。超窗不视为失败：结果可经 GET /action/{id} 补查（保留 ACTION_RESULT_TTL）
API_ACTION_WAIT_MS=6000


# ---------------------------------------------------------------------
# 监控面板（独立只读进程，role=dashboard）
#
# 只读 Redis 中的监控指标并渲染页面，不写任何数据、不参与推送链路。
# 默认仅监听 127.0.0.1 —— 运维数据不应直接暴露到公网；需要远程访问时，
# 用 Nginx 反向代理（附加 Basic Auth）或 SSH 隧道。
# ---------------------------------------------------------------------
DASHBOARD_ENABLE=true
DASHBOARD_LISTEN=http://127.0.0.1:8291
# 页面自动轮询间隔（秒），0 = 关闭自动刷新
DASHBOARD_REFRESH=5


# ---------------------------------------------------------------------
# 报文级限流
#
# 算法：令牌桶。rate = 令牌补充速率（条/秒，即长期平均上限），
#       burst = 桶容量（允许的瞬时突发条数），burst 不得小于 rate。
#       设 rate=0 表示关闭该维度限流。
#
# 分层：ip（L1 网关内存桶，仅 UDP 网关）| conn / uid（L2 业务层 Redis 桶）
#       ping 为心跳独立配额，替代 conn 维度且更严。
# 故障策略：L2 依赖的 Redis 不可用时按 fail-open 放行并告警。
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLE=true
# 每连接：20 条/秒，瞬时突发 40 条
RATE_LIMIT_CONN_RATE=20
RATE_LIMIT_CONN_BURST=40
# 每用户：50 条/秒，瞬时突发 100 条
RATE_LIMIT_UID_RATE=50
RATE_LIMIT_UID_BURST=100
# 每 IP（UDP 网关层）：200 条/秒，瞬时突发 400 条
RATE_LIMIT_IP_RATE=200
RATE_LIMIT_IP_BURST=400
# 心跳 ping：5 条/秒，瞬时突发 10 条
RATE_LIMIT_PING_RATE=5
RATE_LIMIT_PING_BURST=10
# 超限是否断开连接（WebSocket 生效；UDP 恒定静默丢弃）
RATE_LIMIT_CLOSE=false
# 超限是否回错误报文（UDP 恒定不回，避免反射放大）
RATE_LIMIT_NOTIFY=true
# L1 内存桶数量上限，超出按最近使用时间淘汰一半（防伪造源 IP 撑爆内存）
RATE_LIMIT_MEM_MAX=20000


# ---------------------------------------------------------------------
# 业务动作（动作清单见 config/actions.php）
# ---------------------------------------------------------------------
# 单次动作的回执超时（秒），超出由执行器兜底回 5000 并记 action_timeout；0 = 关闭保护
ACTION_TIMEOUT=5
# 上报动作（report）统计键的保留时长（秒）
ACTION_REPORT_TTL=86400


# ---------------------------------------------------------------------
# HTTP 动作队列（Api 进程 -> BusinessWorker）
#
# POST /action 只做验签与参数校验，随后把动作任务写入该队列；
# 由业务进程消费后经 ActionRunner 执行（与 WS / UDP 共用同一条执行路径）。
# 哪些动作可经 HTTP 调用由 config/actions.php 的 'http' => true 逐条开启。
# ---------------------------------------------------------------------
ACTION_QUEUE_ENABLE=true
ACTION_QUEUE_KEY=queue:action:in
# 单次批量消费条数
ACTION_QUEUE_BATCH=100
# 消费周期（秒）。HTTP 调用方在同步等待，该周期直接计入响应延迟
ACTION_QUEUE_INTERVAL=0.02
# 积压告警阈值，超出即告警（不拒绝，队列仍可写入）
ACTION_QUEUE_MAX_LEN=10000
# 动作结果（action:result:{request_id}）保留时长（秒），供 GET /action/{id} 补查
ACTION_RESULT_TTL=60


# ---------------------------------------------------------------------
# 订阅关系
# ---------------------------------------------------------------------
SUBSCRIBE_ENABLE=true
# 订阅关系过期时间（秒），0 = 永不过期
SUBSCRIBE_TTL=0
# 单用户订阅主题数上限，0 = 不限
SUBSCRIBE_MAX_TOPICS=100


# ---------------------------------------------------------------------
# 监控指标
# ---------------------------------------------------------------------
MONITOR_ENABLE=true
# 上报周期（秒）
MONITOR_INTERVAL=60
# 指标数据保留时长（秒）
MONITOR_TTL=600
