{
    "name": "jieyou/gateway-push",
    "description": "Workerman + GatewayWorker 实时数据推送服务（WebSocket + UDP 双协议，单对一定向推送）",
    "type": "project",
    "license": "MIT",
    "keywords": ["workerman", "gatewayworker", "websocket", "udp", "push"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sockets": "*",
        "vlucas/phpdotenv": "^5.6",
        "workerman/gateway-worker": "^3.1",
        "workerman/redis": "^2.0",
        "workerman/workerman": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "GatewayPush\\": "src/",
            "GatewayPush\\Client\\": "client/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GatewayPush\\Tests\\": "tests/",
            "GatewayPush\\Client\\Tests\\": "client/tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "start": "php start.php start",
        "stop": "php start.php stop",
        "restart": "php start.php restart -d",
        "reload": "php start.php reload",
        "svc-status": "php start.php status",
        "check": "php start.php check",
        "env-init": "php start.php env:init",
        "analyse": "phpstan analyse --memory-limit=512M",
        "baseline": "phpstan analyse --memory-limit=512M --generate-baseline",
        "test": "phpunit",
        "test:e2e": "php tests/e2e_check.php",
        "test:client-e2e": "php client/tests/E2E/ClientE2E.php",
        "demo:http": "php tests/Api/http_demo.php"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6"
    }
}
