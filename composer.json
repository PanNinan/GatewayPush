{
    "name": "jieyou/gateway-push",
    "description": "Workerman + GatewayWorker 实时数据推送服务（WebSocket + UDP 双协议，单对一定向推送）",
    "type": "project",
    "license": "MIT",
    "keywords": ["workerman", "gatewayworker", "websocket", "udp", "push"],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sockets": "*",
        "vlucas/phpdotenv": "^5.6",
        "workerman/gateway-worker": "^3.1",
        "workerman/redis": "^2.0",
        "workerman/workerman": "^5.0",
        "ext-zlib": "*"
    },
    "autoload": {
        "psr-4": {
            "GatewayPush\\": "src/",
            "GatewayPush\\Client\\": "client/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GatewayPush\\Tests\\": "tests/",
            "GatewayPush\\Client\\Tests\\": "client/tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "start": "php start.php start",
        "stop": "php start.php stop",
        "restart": "php start.php restart -d",
        "reload": "php start.php reload",
        "svc-status": "php start.php status",
        "check": "php start.php check",
        "env-init": "php start.php env:init",
        "analyse": "phpstan analyse --memory-limit=512M",
        "baseline": "phpstan analyse --memory-limit=512M --generate-baseline",
        "cs": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "cs:check": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "lint": "php vendor/bin/phpcs --standard=phpcs.xml.dist",
        "lint:summary": "php vendor/bin/phpcs --standard=phpcs.xml.dist --report=source --no-colors",
        "lint:errors": "php vendor/bin/phpcs --standard=phpcs.xml.dist --warning-severity=0",
        "lint:self": "php tests/Manual/phpcs_business_rules_check.php",
        "test": "phpunit",
        "test:e2e": "php tests/e2e_check.php",
        "test:client-e2e": "php client/tests/E2E/ClientE2E.php",
        "test:sign": "node tests/Api/api_sign_check.js",
        "test:frontend": "node tests/Frontend/dashboard_autorefresh_check.js",
        "test:docs": "php tests/Manual/docs_numbers_check.php",
        "demo:http": "php tests/Api/http_demo.php"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
