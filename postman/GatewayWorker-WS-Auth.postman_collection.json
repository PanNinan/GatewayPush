{
  "info": {
    "name": "GatewayWorker WS 鉴权",
    "description": "连接 WebSocket 网关并完成 auth 鉴权。Pre-request 脚本每次连接前自动用 AUTH_SECRET 生成有效 Token，并以 {{auth_body}} / {{echo_body}} 变量暴露报文，连接后在 Messages 框发送这两个变量即可。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "ws_url", "value": "ws://127.0.0.1:8282" },
    { "key": "uid", "value": "testuser" },
    { "key": "device_id", "value": "postman-001" },
    { "key": "secret", "value": "ebc5f58d3744bc4c8609d5d232be6d07f782c028e2bb83cf2254346b3a599aee" },
    { "key": "ttl", "value": "7200" }
  ],
  "item": [
    {
      "name": "WS 连接并鉴权",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ===== 自动生成鉴权报文（无需 CLI） =====",
              "const secret    = pm.collectionVariables.get('secret') || 'ebc5f58d3744bc4c8609d5d232be6d07f782c028e2bb83cf2254346b3a599aee';",
              "const uid       = pm.collectionVariables.get('uid')   || 'testuser';",
              "const deviceId  = pm.collectionVariables.get('device_id') || 'postman-001';",
              "const ttl       = parseInt(pm.collectionVariables.get('ttl') || '7200', 10);",
              "",
              "function b64urlFromWA(wa) {",
              "  return CryptoJS.enc.Base64.stringify(wa).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
              "}",
              "function b64urlFromString(s) {",
              "  return b64urlFromWA(CryptoJS.enc.Utf8.parse(s));",
              "}",
              "",
              "// ---- 生成 Token: base64url(payload).base64url(hmac(payload)) ----",
              "const now = Math.floor(Date.now() / 1000);",
              "const payload = { uid: uid, device_id: deviceId, iat: now, exp: now + ttl, nonce: CryptoJS.lib.WordArray.random(8).toString() };",
              "const body = b64urlFromString(JSON.stringify(payload));",
              "const sign = b64urlFromWA(CryptoJS.HmacSHA256(body, secret));",
              "const token = body + '.' + sign;",
              "",
              "// ---- 报文签名（WS 侧不校验，仅作兼容/调试） ----",
              "const cmd = 'auth';",
              "const seq = '1';",
              "const ts  = now;",
              "const data = {};",
              "const canonical = JSON.stringify(data); // {}",
              "const base = [cmd, seq, ts, deviceId, token, canonical].join('|');",
              "const packetSign = CryptoJS.HmacSHA256(base, secret).toString(CryptoJS.enc.Hex);",
              "",
              "const authPacket = { cmd: cmd, seq: seq, ts: ts, uid: '', device_id: deviceId, token: token, sign: packetSign, data: data };",
              "pm.collectionVariables.set('auth_body', JSON.stringify(authPacket));",
              "pm.collectionVariables.set('token', token);",
              "",
              "// ---- 鉴权后的 echo 报文（验证链路） ----",
              "const echoPacket = { cmd: 'data', seq: '2', ts: now, uid: uid, device_id: deviceId, token: token, sign: '', data: { action: 'echo', params: { hello: 'postman' } } };",
              "pm.collectionVariables.set('echo_body', JSON.stringify(echoPacket));",
              "",
              "console.log('Token 已生成，有效期 ' + ttl + 's');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{ws_url}}",
          "protocol": "ws",
          "host": ["{{ws_url}}"],
          "path": []
        },
        "description": "连接成功后，必须在 15 秒内发送 auth 报文（AUTH_TIMEOUT=15）。在 Messages 框分别发送变量 {{auth_body}} 与 {{echo_body}}。"
      },
      "response": []
    }
  ],
  "protocolProfileBehavior": {
    "strictSSL": false,
    "disableBodyPruning": true
  }
}
