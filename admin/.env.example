# =============================================================================
# GatewayPush 管理后台 —— 配置模板
#
# 用法：cp .env.example .env 后填写。.env 已在 .gitignore 中，不会进版本库。
#
# ⚠ 三项硬纪律（详见 docs/GatewayPush WebmanAdmin 管理后台详细设计.md §5.4）：
#   1. ADMIN_API_SECRET 不进 MySQL，只从本文件注入；UI 只展示「是否为空 / 是否回退 / 脱敏值」。
#   2. ADMIN_REDIS_DB 与 ADMIN_REDIS_PREFIX 必须与主项目一致 —— 配错的表现是「读到空数据」
#      而不是报错，属静默错误，故 /api/ops/redis/scan 会做一次预期键存在性自检。
#   3. 不做 .env 热重载：改本文件只对**新启动**的后台进程生效（webman 常驻，无热重载）。
# =============================================================================

# --- 后台自身 ---
ADMIN_APP_ENV=dev
# 监听地址：必须回环（后台无 TLS）。改这里要同步 netstat 检查清单。
ADMIN_LISTEN=http://127.0.0.1:8292

# --- 后台自有 MySQL（仅后台库；推送系统运行不依赖它）---
ADMIN_DB_HOST=127.0.0.1
ADMIN_DB_PORT=3306
ADMIN_DB_NAME=gateway_push_admin
ADMIN_DB_USER=gw_admin
ADMIN_DB_PASS=

# --- 对接主项目 HTTP API ---
# 留空则由**服务端**回退到 AUTH_SECRET（与服务端 apiSecret() 行为一致）。
# ⚠ 本密钥同时是**管理面凭证**：P4 起 kick / revoke / unbind 以 channels=[http] 开放，
#   持本密钥者即可调用它们。**不得下发给任何业务调用方**（已决策项 A，2026-09-23）。
ADMIN_API_SECRET=
ADMIN_API_URL=http://127.0.0.1:8290
ADMIN_DASHBOARD_URL=http://127.0.0.1:8291

# --- 主项目只读资产（同机路径）---
ADMIN_PROJECT_ROOT=..
ADMIN_LOG_DIR=../runtime/logs
# ⚠ 含空格的值**必须**用双引号包起来，否则 phpdotenv 会因 "unexpected whitespace" 直接抛异常
ADMIN_ROLES_CMD="php ../start.php roles"

# --- Redis（只读；复用主项目同一实例同一 DB）---
ADMIN_REDIS_HOST=127.0.0.1
ADMIN_REDIS_PORT=6379
ADMIN_REDIS_PASSWORD=
# 本机主项目为 9（DB0 有历史残留 gwpush:* 键）
ADMIN_REDIS_DB=9
# 必须与主项目 config/app.php 的 REDIS_PREFIX 一致
ADMIN_REDIS_PREFIX=gwpush:

# --- 初始超管账号（仅 scripts/install.php 首次建号时读取）---
# wa_admins 非空后本段即失效 —— 生产环境部署完成后应清空 ADMIN_BOOTSTRAP_PASS。
# 密码要求：非空即可（webman-admin 的建号流程不做强度校验），但请自行保证强度。
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=
