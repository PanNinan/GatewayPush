# ---------------------------------------------------------------------
# 测试代码专属 baseline —— 冻结 tests / client/tests 的存量
#
# 为什么单独一个文件（而不并入 phpstan-baseline.neon）：
#   src / client/src 是生产代码，维持「新代码零容忍、baseline 只冻结极少数存量」；
#   tests 是验证代码，存量天然更多。
#   分成两个文件，才能让「src 侧 baseline 是否又长了」这个信号保持清晰。
#
# ⚠ 只许减、不许增：新增测试代码必须零告警，不得往这里追加条目。
#   唯一例外是 PHPStan 对「按引用捕获的闭包」看不穿赋值导致的误判 ——
#   这类条目若要新增，必须逐条注明原因。
#
# 存量构成（339 条 / 324 条目）：
#   【2026-09-22 提级至 level 6 时重新生成 —— 新增的 273 条全部是 missingType.*】
#   - missingType.return（165）：测试替身 / 辅助方法缺返回类型。测试里
#     `private function open() { ... }` 这类写法补 `: void` 收益极低，
#     且引入原生类型反而有 TypeError 风险，故整批冻结。
#   - missingType.iterableValue（68）/ parameter（33）/ property（7）：
#     测试夹具的 `array` 形参、`public $x;` 属性缺值类型，同属低收益标注。
#   - staticMethod/method.alreadyNarrowedType（26）：golden 值钉桩。
#     如 assertSame(4004, ErrorCode::HTTP_NOT_FOUND) —— 常量被静态解析成字面量，
#     PHPStan 判定断言恒真；但该断言的意图正是「钉住未来被改动的数值」。
#   - staticMethod.impossibleType（4）：PHPUnit 断言落在按引用捕获的变量上，
#     PHPStan 看不到闭包里的赋值，误判为 null / 空数组。
#   - cast.useless（13）/ closure.unusedUse（2）：纯机械噪音。
#   - property.onlyWritten（4）/ parameterByRef.unusedType（3）/ nullsafe.neverNull（2）等。
#
# 重新生成方法（仅在提级等结构变化时用，且必须在提交信息里写明原因）：
#   1) phpstan.neon 的 level 改为目标级别，并**临时注释掉两个 baseline 的 includes**
#      —— 否则已冻结的条目会先把错误吃掉，生成出来的 baseline 会缺条目；
#   2) php vendor/bin/phpstan analyse --generate-baseline=phpstan-tests-baseline.neon
#      —— 注意它按 `parameters.paths` 全量生成，会把生产侧那 9 条一并写进来；
#   3) 剔除 path 不以 `tests/` 或 `client/tests/` 开头的条目（那 9 条属 phpstan-baseline.neon）；
#   4) 恢复 includes 后再跑一次 `composer analyse`，必须 0 errors
#      —— 若出现 `ignore.unmatched`，说明第 3 步剔错了条目。
# ---------------------------------------------------------------------

parameters:
	ignoreErrors:
		-
			message: '#^Anonymous function has an unused use \$ws\.$#'
			identifier: closure.unusedUse
			count: 1
			path: client/tests/E2E/ClientE2E.php

		-
			message: '#^Call to function in_array\(\) with arguments 4008, array\{\} and true will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: client/tests/E2E/ClientE2E.php

		-
			message: '#^Casting to string something that''s already string\.$#'
			identifier: cast.useless
			count: 1
			path: client/tests/E2E/ClientE2E.php

		-
			message: '#^Strict comparison using \=\=\= between \*NEVER\* and 0 will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: client/tests/E2E/ClientE2E.php

		-
			message: '#^Using nullsafe method call on non\-nullable type GatewayPush\\Client\\Session\\SessionManager\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: client/tests/E2E/ClientE2E.php

		-
			message: '#^Method GatewayPush\\Client\\Tests\\Support\\FakeHttpConnection\:\:connect\(\) has no return type specified\.$#'
